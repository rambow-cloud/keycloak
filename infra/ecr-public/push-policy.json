{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushAndInspectOnlyKeycloak",
      "Effect": "Allow",
      "Action": [
        "ecr-public:BatchCheckLayerAvailability",
        "ecr-public:InitiateLayerUpload",
        "ecr-public:UploadLayerPart",
        "ecr-public:CompleteLayerUpload",
        "ecr-public:PutImage",
        "ecr-public:DescribeImages"
      ],
      "Resource": "arn:aws:ecr-public::060065238923:repository/keycloak"
    },
    {
      "Sid": "PublicRegistryAuthentication",
      "Effect": "Allow",
      "Action": "ecr-public:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "OnlyEcrPublicServiceBearerToken",
      "Effect": "Allow",
      "Action": "sts:GetServiceBearerToken",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sts:AWSServiceName": "ecr-public.amazonaws.com"
        }
      }
    }
  ]
}
