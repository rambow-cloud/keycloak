{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubProtectedKeycloakRelease",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::060065238923:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:rambow-cloud@333554680/keycloak@1433566126:environment:ecr-public-release"
        }
      }
    }
  ]
}
