# Core profile; mount the public RDS CA bundle read-only at the path below.
KC_DB_URL=jdbc:postgresql://REPLACE_RDS_ENDPOINT:5432/keycloak
KC_DB_USERNAME=keycloak_password
# Inject KC_DB_PASSWORD through your runtime secret store. Never commit its value.
KC_DB_TLS_MODE=verify-server
KC_DB_TLS_TRUST_STORE_FILE=/run/certs/rds-ca.pem
KC_DB_SCHEMA=public
KC_DB_CONNECT_TIMEOUT=10s
KC_DB_POOL_INITIAL_SIZE=2
KC_DB_POOL_MIN_SIZE=2
KC_DB_POOL_MAX_SIZE=20
