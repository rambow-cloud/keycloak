# Experimental: PolarDB PostgreSQL edition, core image, private primary endpoint.
# Select the PRIMARY endpoint in the console, not the automatic read/write-splitting endpoint.
KC_DB_URL=jdbc:postgresql://REPLACE_POLARDB_PRIMARY_ENDPOINT:5432/keycloak
KC_DB_USERNAME=keycloak
# Inject KC_DB_PASSWORD from your runtime secret store; do not put it in the URL.
KC_DB_SCHEMA=public
KC_DB_TLS_MODE=verify-server
KC_DB_TLS_TRUST_STORE_FILE=/run/certs/polardb-ca.pem
KC_DB_CONNECT_TIMEOUT=10s
KC_DB_POOL_INITIAL_SIZE=2
KC_DB_POOL_MIN_SIZE=2
KC_DB_POOL_MAX_SIZE=20
