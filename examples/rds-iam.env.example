# AWS profile. ECS supplies credentials through the task role, not the execution role.
KC_DB_URL=jdbc:aws-wrapper:postgresql://REPLACE_RDS_ENDPOINT:5432/keycloak?wrapperPlugins=iam
KC_DB_USERNAME=keycloak_iam
AWS_REGION=REPLACE_AWS_REGION
# Omit database passwords and static AWS access keys.
KC_DB_TLS_MODE=verify-server
KC_DB_TLS_TRUST_STORE_FILE=/opt/keycloak/certs/rds-ca-bundle.pem
KC_DB_SCHEMA=public
KC_DB_CONNECT_TIMEOUT=10s
KC_DB_POOL_INITIAL_SIZE=2
KC_DB_POOL_MIN_SIZE=2
KC_DB_POOL_MAX_SIZE=20
